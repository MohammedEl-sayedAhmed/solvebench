# Normalize line endings so shell scripts and sources work on every OS.
* text=auto

# Unix scripts and sources must stay LF, even when checked out on Windows.
*.sh   text eol=lf
*.py   text eol=lf
*.ps1  text eol=lf
Dockerfile text eol=lf

# Windows batch files need CRLF.
*.cmd  text eol=crlf
*.bat  text eol=crlf
