{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cpp: build current file",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-g",
        "-I", "${workspaceFolder}/cpp",
        "${file}",
        "-o", "${fileDirname}/${fileBasenameNoExtension}.out"
      ],
      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run: current solution (all languages)",
      "type": "shell",
      "command": "python3",
      "args": ["run.py", "${relativeFileDirname}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
